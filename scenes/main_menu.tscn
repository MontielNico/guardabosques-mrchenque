[node name="HSeparator" type="HSeparator" parent="Panel/Margin/VBox"]
layout_mode = 2

[node name="LoreLabel" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.88, 0.9, 1)
theme_override_font_sizes/font_size = 14
text = "Eres Mr. Chenque, guardaparques a cargo del control de ingreso durante 5 días cruciales.

• Inspecciona vehículos, baúles, pasajeros y documentos de cada visitante.
• Compara con las condiciones del día (Riesgo de Incendio, Época del año y Fauna protegida).
• Atiende las emergencias de radio para frenar incendios, cazadores y usurpaciones.
• Mantén a salvo el ecosistema del parque y ahorra dinero para el sustento de tu familia."
autowrap_mode = 3

[node name="HSeparator2" type="HSeparator" parent="Panel/Margin/VBox"]
layout_mode = 2

