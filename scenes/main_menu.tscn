[node name="LoreLabel" type="Label" parent="Panel/Margin/VBox" unique_id=405738973]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.88, 0.9, 1)
theme_override_font_sizes/font_size = 13
text = "Eres Mr. Chenque, guardaparques a cargo del control de acceso durante 5 días consecutivos.

• Vista dividida en 5 ventanas funcionales: Oficina/Auto, Rostro del Visitante, Mapa de 5 Parcelas / Baúl, Escritorio y Panel de Decisiones.
• Pasa a 'Vista de Investigación' para abrir el baúl, revisar pertenencias e interrogar al visitante.
• Cada infracción no detectada degradará visiblemente las parcelas del parque en el mapa general y descontará multas de tu fondo familiar."
autowrap_mode = 3

